# ==============================================================================
# Medax Backend — Muhit O'zgaruvchilari (Environment Variables)
# ==============================================================================
# Ushbu fayldan nusxa olib, backend/.env faylini yarating: cp .env.example backend/.env

DATABASE_URL="postgresql://medax_user:STRONG_DB_PASSWORD@localhost:5432/medax_db?schema=public"
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://medax.uz,https://www.medax.uz"
UPLOAD_DIR="./uploads"

# Kriptografik sirlar (openssl rand -hex 32 bilan yarating)
JWT_SECRET="GENERATE_UNIQUE_RANDOM_SECRET_FOR_ADMIN_JWT_32CHARS_MIN"
CUSTOMER_JWT_SECRET="GENERATE_SEPARATE_RANDOM_SECRET_FOR_CUSTOMER_JWT_32CHARS"

ADMIN_EMAIL="admin@medax.uz"
ADMIN_PASSWORD="CHANGE_TO_SUPER_SECURE_ADMIN_PASSWORD_2026!"

# SMS Provayderi (Eskiz.uz yoki test uchun console)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL="your_eskiz_account_email@domain.uz"
ESKIZ_PASSWORD="your_eskiz_account_password"
ESKIZ_FROM="4546"

# SMS Byudjeti va xavfsizlik limitlari
DAILY_SMS_BUDGET=250
DAILY_IP_SMS_LIMIT=8
HOURLY_PHONE_OTP_LIMIT=4
FAKE_STRIKE_LIMIT=2

# EmailJS orqali xabar yuborish (emailjs.com)
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_ORDER_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
GMAIL_DESTINATION="medaxuz@gmail.com"

# Sun'iy intellekt: admin panelda mahsulot kartasini avtomatik to'ldirish
# Standart provayder — Google Gemini. Kalit: https://aistudio.google.com -> "Get API key" (bepul tarif bor).
# Bo'sh qolsa, AI tugmasi o'chiq turadi, qolgan tizim odatdagidek ishlaydi.
AI_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"
# Ixtiyoriy: AI_PROVIDER=claude bo'lsa, Claude ishlatiladi (https://platform.claude.com)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
AI_EFFORT=medium
AI_HOURLY_LIMIT=60

# Proksi va Cloudflare Turnstile
BEHIND_CLOUDFLARE=false
TRUST_PROXY="1"
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""
