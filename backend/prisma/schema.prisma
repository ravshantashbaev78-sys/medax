generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
}

enum OrderStatus {
  NEW
  CONFIRMED
  READY
  DONE
  CANCELED
  FAKE
}

enum BlockType {
  PHONE
  IP
}

enum ErpDocType {
  INCOME
  OUTCOME
  TRANSFER
  RETURN_CUSTOMER
  RETURN_SUPPLIER
  WRITE_OFF
}

enum CashType {
  INCOME
  EXPENSE
}

enum PaymentType {
  CASH
  CARD
  BANK_TRANSFER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  // Shu vaqtdan oldin berilgan tokenlar yaroqsiz (parol almashtirilganda eski sessiyalar yopiladi)
  passwordChangedAt DateTime?
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  country  String?
  products Product[]
}

model Product {
  id            Int               @id @default(autoincrement())
  slug          String            @unique
  sku           String?           @unique
  name          String
  nameRu        String?
  nameEn        String?
  description   String            @default("")
  descriptionRu String?
  descriptionEn String?
  specs         Json              @default("[]")
  country       String?
  priceFrom       Decimal?          @db.Decimal(14, 2)
  oldPrice        Decimal?          @db.Decimal(14, 2)
  discountPercent Int?
  unit            String?           @default("dona")
  packageQty      Int?              @default(1)
  stock           Int               @default(0)
  costPrice       Decimal?          @db.Decimal(14, 2)
  markupPercent   Decimal?          @db.Decimal(6, 2)
  minStock        Int               @default(5)
  batchNumber     String?
  mfdDate         String?
  expDate         String?
  isHit           Boolean           @default(false)
  isNew           Boolean           @default(false)
  isActive        Boolean           @default(true)
  categoryId      Int
  category        Category          @relation(fields: [categoryId], references: [id])
  brandId         Int?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  supplierId      Int?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId     Int?
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  documents       ProductDocument[]
  orderItems      OrderItem[]
  erpDocItems     ErpDocumentItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductDocument {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  url       String
}

model Order {
  id              Int         @id @default(autoincrement())
  code            String      @unique
  customerName    String
  phone           String
  organization    String      @default("")
  deliveryAddress String      @default("")
  paymentMethod   String      @default("")
  comment         String      @default("")
  status          OrderStatus @default(NEW)
  managerNote     String      @default("")
  ip              String?
  flags           String[]    @default([])
  items           OrderItem[]
  customerId      Int?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount     Decimal?    @db.Decimal(14, 2)
  isPaid          Boolean     @default(false)
  paidAt          DateTime?
  stockDeducted   Boolean     @default(false)
  cashEntries     CashEntry[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([phone])
  @@index([status, createdAt])
  @@index([customerId])
}

model Customer {
  id                     Int            @id @default(autoincrement())
  phone                  String?        @unique
  name                   String
  organization           String?        @default("")
  inn                    String?
  clientCategory         String?        @default("KLINIKA")
  balance                Decimal        @default(0) @db.Decimal(14, 2)
  avatar                 String?
  passwordHash           String?
  passwordChangedAt      DateTime?
  resetPasswordOtpSentAt DateTime?
  pushToken              String?
  hasApp                 Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  orders                 Order[]
  notifications          Notification[]
  erpDocuments           ErpDocument[]
  cashEntries            CashEntry[]

  @@index([phone])
}

model Notification {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String?
  title      String
  body       String
  orderId    Int?
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([phone, createdAt])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  price       Decimal? @db.Decimal(14, 2)
}

model OtpCode {
  id        Int       @id @default(autoincrement())
  phone     String
  purpose   String    @default("AUTH") // "AUTH" (login/register), "ORDER", "RESET_PASSWORD"
  codeHash  String
  attempts  Int       @default(0)
  ip        String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([phone, purpose, createdAt])
}

model Blocked {
  id        Int       @id @default(autoincrement())
  type      BlockType
  value     String
  reason    String    @default("")
  createdAt DateTime  @default(now())

  @@unique([type, value])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model Warehouse {
  id        Int           @id @default(autoincrement())
  name      String        // e.g. "Asosiy ombor", "Namangan do'koni", "Toshkent filiali"
  address   String?
  isDefault Boolean       @default(false)
  products  Product[]
  fromDocs  ErpDocument[] @relation("FromWarehouse")
  toDocs    ErpDocument[] @relation("ToWarehouse")
  createdAt DateTime      @default(now())
}

model Supplier {
  id          Int           @id @default(autoincrement())
  name        String        // e.g. "Юсуфхон ака", "INTERMED INNOVATION"
  company     String?
  phone       String?
  inn         String?       // STIR
  address     String?
  balance     Decimal       @default(0) @db.Decimal(14, 2)
  notes       String?
  products    Product[]
  documents   ErpDocument[]
  cashEntries CashEntry[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ErpDocument {
  id                Int               @id @default(autoincrement())
  docNumber         String            @unique // e.g. "PR-2026-0001", "RS-2026-0001"
  type              ErpDocType
  date              DateTime          @default(now())
  warehouseId       Int?
  warehouse         Warehouse?        @relation("FromWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  targetWarehouseId Int?
  targetWarehouse   Warehouse?        @relation("ToWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  supplierId        Int?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId        Int?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientName        String?
  totalAmount       Decimal           @default(0) @db.Decimal(14, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(14, 2)
  status            String            @default("CONFIRMED") // DRAFT, CONFIRMED
  notes             String?
  items             ErpDocumentItem[]
  cashEntries       CashEntry[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, date])
  @@index([supplierId])
  @@index([customerId])
}

model ErpDocumentItem {
  id          Int         @id @default(autoincrement())
  documentId  Int
  document    ErpDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product     @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  costPrice   Decimal?    @db.Decimal(14, 2)
  markup      Decimal?    @db.Decimal(6, 2)
  sellPrice   Decimal?    @db.Decimal(14, 2)
  totalPrice  Decimal     @db.Decimal(14, 2)
  batchNumber String?
  expDate     String?
}

model CashEntry {
  id          Int          @id @default(autoincrement())
  entryNumber String       @unique // e.g. "KAS-2026-0001"
  type        CashType
  category    String       // "MIJOZ_TOLOV", "TAMINOTCHI_TOLOV", "IJARA", "TRANSPORT", "OYLIK", "BOSHQA"
  amount      Decimal      @db.Decimal(14, 2)
  paymentType PaymentType  @default(CASH)
  date        DateTime     @default(now())
  description String?
  customerId  Int?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  Int?
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  documentId  Int?
  document    ErpDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  orderId     Int?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([type, date])
  @@index([customerId])
  @@index([supplierId])
}
