# ==============================================================================
# Medax Backend — Muhit O'zgaruvchilari (Environment Variables)
# ==============================================================================
# Ushbu fayldan nusxa olib, yangi .env faylini yarating: cp .env.example .env
# Production muhitida barcha sirlarni alohida kuchli kalitlar bilan to'ldiring!

# 1. Baza konfiguratsiyasi (PostgreSQL)
DATABASE_URL="postgresql://medax_user:STRONG_DB_PASSWORD@localhost:5432/medax_db?schema=public"

# 2. Server porti va rejimi
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://medax.uz,https://www.medax.uz"
UPLOAD_DIR="./uploads"

# 3. Kriptografik sirlar (DIQQAT: openssl rand -hex 32 orqali 2 ta alohida kalit yarating!)
# Admin va xodimlar tokenlari uchun (kamida 32 ta belgi):
JWT_SECRET="GENERATE_UNIQUE_RANDOM_SECRET_FOR_ADMIN_JWT_32CHARS_MIN"

# Mijozlar tokenlari uchun (Admin kalitidan mutlaqo ALOHIDA bo'lishi shart):
CUSTOMER_JWT_SECRET="GENERATE_SEPARATE_RANDOM_SECRET_FOR_CUSTOMER_JWT_32CHARS"

# 4. Boshlang'ich Admin hisobi (faqat seed orqali dastlabki yaratish uchun)
ADMIN_EMAIL="admin@medax.uz"
ADMIN_PASSWORD="CHANGE_TO_SUPER_SECURE_ADMIN_PASSWORD_2026!"

# 5. SMS Provayderi (Eskiz.uz)
# Ishlab chiqish/test muhitida: console (SMS kod konsolda chiqadi)
# Haqiqiy serverda (Production): eskiz
SMS_PROVIDER=eskiz
ESKIZ_EMAIL="your_eskiz_account_email@domain.uz"
ESKIZ_PASSWORD="your_eskiz_account_password"
ESKIZ_FROM="4546"

# 6. SMS Balansini himoyalash va Spamlarga qarshi byudjet (Muhim!)
DAILY_SMS_BUDGET=250           # Butun server bo'yicha 24 soatda yuboriladigan maksimal SMS soni
DAILY_IP_SMS_LIMIT=8          # Bitta IP manzildan 24 soatda so'ralishi mumkin bo'lgan maksimal SMS
HOURLY_PHONE_OTP_LIMIT=4      # Bitta telefon raqamiga 1 soatda yuboriladigan maksimal OTP kod
FAKE_STRIKE_LIMIT=2           # Nechta soxta buyurtmadan so'ng raqam avtomatik bloklanadi

# 7. Tarmoq va Proksi konfiguratsiyasi (Cloudflare / Nginx)
# Agar sayt Cloudflare orqali yo'naltirilgan bo'lsa: true qiling (CF-Connecting-IP ishlatiladi)
BEHIND_CLOUDFLARE=false

# Express trust proxy sozlamasi:
# Nginx orqasida: 1 yoki loopback
# Cloudflare orqasida: true yoki loopback
TRUST_PROXY="1"

# 8. Botlardan himoyalanish uchun Captcha (Cloudflare Turnstile)
# Agar bepul Cloudflare Turnstile yoqilgan bo'lsa, maxfiy kalitni kiriting:
TURNSTILE_SECRET_KEY=""

# 9. EmailJS (emailjs.com) orqali medaxuz@gmail.com ga xabar jo'natish
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_ORDER_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
GMAIL_DESTINATION="medaxuz@gmail.com"
